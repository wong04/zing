{
	"limits": { "usernameMax": 512, "passwordMax": 1024, "holdMs": 10000, "settleChecks": 5, "watchMs": 120000, "usernameStepMs": 300000 },
	"withdrawals": [
		{ "name": "the form back in the same origin withdraws the prompt", "promptOrigin": "https://a.example", "landed": "https://a.example", "hasVisiblePasswordBox": true, "expected": true },
		{ "name": "no password box does not", "promptOrigin": "https://a.example", "landed": "https://a.example", "hasVisiblePasswordBox": false, "expected": false },
		{ "name": "a form in another origin does not", "promptOrigin": "https://a.example", "landed": "https://b.example", "hasVisiblePasswordBox": true, "expected": false }
	],
	"sameSite": [
		{ "name": "subdomains of one site pair", "a": "https://id.bank.com", "b": "https://auth.bank.com", "expected": true },
		{ "name": "a sibling under a two-part suffix pairs", "a": "https://a.example.co.uk", "b": "https://b.example.co.uk", "expected": true },
		{ "name": "different sites do not", "a": "https://login.live.com", "b": "https://login.microsoftonline.com", "expected": false },
		{ "name": "two users of a shared host are two sites", "a": "https://alice.github.io", "b": "https://bob.github.io", "expected": false },
		{ "name": "two universities under ac.za are two sites", "a": "https://uct.ac.za", "b": "https://wits.ac.za", "expected": false },
		{ "name": "http and https do not pair", "a": "https://bank.com", "b": "http://bank.com", "expected": false },
		{ "name": "another port does not pair", "a": "https://bank.com", "b": "https://bank.com:8443", "expected": false },
		{ "name": "the same address pairs", "a": "http://127.0.0.1:3000", "b": "http://127.0.0.1:3000", "expected": true },
		{ "name": "another address does not", "a": "http://127.0.0.1:3000", "b": "http://127.0.0.2:3000", "expected": false }
	],
	"outcomes": [
		{ "name": "the same origin with no password box any more is a success", "submitted": "https://a.example", "landed": "https://a.example", "hasVisiblePasswordBox": false, "expected": "success" },
		{ "name": "the same origin with the password box back is a failure", "submitted": "https://a.example", "landed": "https://a.example", "hasVisiblePasswordBox": true, "expected": "failed" },
		{ "name": "another origin with no password box is not a verdict", "submitted": "https://a.example", "landed": "https://b.example", "hasVisiblePasswordBox": false, "expected": "pending" },
		{ "name": "another origin with a password box is not a verdict either", "submitted": "https://a.example", "landed": "https://sso.example", "hasVisiblePasswordBox": true, "expected": "pending" },
		{ "name": "a different port is another origin", "submitted": "http://127.0.0.1:3000", "landed": "http://127.0.0.1:3001", "hasVisiblePasswordBox": false, "expected": "pending" },
		{ "name": "http and https are different origins", "submitted": "https://a.example", "landed": "http://a.example", "hasVisiblePasswordBox": false, "expected": "pending" }
	]
}
