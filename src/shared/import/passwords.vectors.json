{
	"parse": [
		{
			"name": "a four-column Chrome export without the note column",
			"csv": "name,url,username,password\nsite,https://a.example,u,p\n",
			"format": "chromium",
			"logins": [{ "title": "site", "url": "https://a.example", "username": "u", "password": "p", "note": "" }],
			"skipped": []
		},
		{
			"name": "a 1Password export without the Notes column",
			"csv": "Title,Url,Username,Password\nBank,https://bank.example,me,pw\n",
			"format": "onepassword",
			"logins": [{ "title": "Bank", "url": "https://bank.example", "username": "me", "password": "pw", "note": "" }],
			"skipped": []
		},
		{
			"name": "a Bitwarden export with only the login columns",
			"csv": "login_uri,login_username,login_password\nhttps://mail.example.com,a@b.c,pw\n",
			"format": "bitwarden",
			"logins": [{ "title": "mail.example.com", "url": "https://mail.example.com", "username": "a@b.c", "password": "pw", "note": "" }],
			"skipped": []
		},
		{
			"name": "a Chrome export with quoted commas, quotes and newlines",
			"csv": "name,url,username,password,note\r\ngithub.com,https://github.com/login,me,s3cret,\"two, words\"\r\nbank,https://bank.example,ada,\"p\"\"w\",\"line one\nline two\"\r\n",
			"format": "chromium",
			"logins": [
				{ "title": "github.com", "url": "https://github.com/login", "username": "me", "password": "s3cret", "note": "two, words" },
				{ "title": "bank", "url": "https://bank.example", "username": "ada", "password": "p\"w", "note": "line one\nline two" }
			],
			"skipped": []
		},
		{
			"name": "a byte-order mark before the header",
			"csv": "\ufeffname,url,username,password,note\nsite,https://s.example,u,p,\n",
			"format": "chromium",
			"logins": [{ "title": "site", "url": "https://s.example", "username": "u", "password": "p", "note": "" }],
			"skipped": []
		},
		{
			"name": "a title missing from the row is the hostname",
			"csv": "name,url,username,password,note\n,https://s.example/login,u,p,\n",
			"format": "chromium",
			"logins": [{ "title": "s.example", "url": "https://s.example/login", "username": "u", "password": "p", "note": "" }],
			"skipped": []
		},
		{
			"name": "a blank password, an android:// row and a non-address are each skipped with the reason",
			"csv": "name,url,username,password,note\nblank,https://a.example,u,,\napp,android://hash@com.app/,u,p,\nbad,not a url,u,p,\nnone,,u,p,\nok,https://ok.example,u,p,\n",
			"format": "chromium",
			"logins": [{ "title": "ok", "url": "https://ok.example", "username": "u", "password": "p", "note": "" }],
			"skipped": [
				{ "row": 2, "reason": "No password" },
				{ "row": 3, "reason": "Not a web address: android://hash@com.app/" },
				{ "row": 4, "reason": "Not a web address: not a url" },
				{ "row": 5, "reason": "No web address" }
			]
		},
		{
			"name": "Bitwarden skips items that are not logins",
			"csv": "folder,favorite,type,name,notes,fields,reprompt,login_uri,login_username,login_password,login_totp\n,,login,Mail,,,0,https://mail.example.com,a@b.c,pw,\n,,note,Secret note,hello,,0,,,,\n",
			"format": "bitwarden",
			"logins": [{ "title": "Mail", "url": "https://mail.example.com", "username": "a@b.c", "password": "pw", "note": "" }],
			"skipped": [{ "row": 3, "reason": "Bitwarden note item, not a login" }]
		},
		{
			"name": "1Password",
			"csv": "Title,Url,Username,Password,OTPAuth,Favorite,Archived,Tags,Notes\nBank,https://bank.example,me,pw,,false,false,,remember\n",
			"format": "onepassword",
			"logins": [{ "title": "Bank", "url": "https://bank.example", "username": "me", "password": "pw", "note": "remember" }],
			"skipped": []
		},
		{
			"name": "Firefox has no title, so the hostname is used",
			"csv": "\"url\",\"username\",\"password\",\"httpRealm\",\"formActionOrigin\",\"guid\",\"timeCreated\",\"timeLastUsed\",\"timePasswordChanged\"\n\"https://a.example\",\"u\",\"p\",,\"https://a.example\",\"{x}\",\"1\",\"1\",\"1\"\n",
			"format": "firefox",
			"logins": [{ "title": "a.example", "url": "https://a.example", "username": "u", "password": "p", "note": "" }],
			"skipped": []
		}
	],
	"refused": [
		{ "name": "an unknown set of columns", "csv": "a,b\n1,2\n", "error": "unknown" },
		{ "name": "an unterminated quote", "csv": "name,url,username,password,note\n\"abc,https://a.example,u,p,\n", "error": "syntax" },
		{ "name": "a row with the wrong number of fields", "csv": "name,url,username,password,note\na,https://a.example,u\n", "error": "syntax" },
		{ "name": "a quote inside an unquoted field", "csv": "name,url,username,password,note\nab\"c,https://a.example,u,p,\n", "error": "syntax" },
		{ "name": "an empty file", "csv": "", "error": "syntax" }
	]
}
