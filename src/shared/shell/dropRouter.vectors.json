{
	"comment": "Bytes are given as hex plus a count of trailing zero bytes (hex + zeros). plans: planDrop with now = 2025-07-29T14:40:00Z; payload.image is bytes; want is a plan ({kind, ...}, bytes as hex+zeros) or null. droppedNames, downloadNames, sniff, uniqueNames, filePaths, webUrls, safeNames, extensions, targets (acceptsFiles by panel id), dragTypes (acceptsDrag / noticesDrag).",
	"plans": [
		{
			"name": "file URL drag",
			"payload": { "fileLocation": "file:///C:/Users/me/AppData/Local/Temp/drop-src.png" },
			"want": { "kind": "open", "path": "C:\\Users\\me\\AppData\\Local\\Temp\\drop-src.png" }
		},
		{
			"name": "raw image bytes are written under a sniffed name",
			"payload": { "image": { "hex": "89504e470d0a1a0a", "zeros": 40 }, "suggestedName": "from-web" },
			"want": { "kind": "write", "name": "from-web.png", "bytes": { "hex": "89504e470d0a1a0a", "zeros": 40 } }
		},
		{
			"name": "a web URL is downloaded",
			"payload": { "url": "https://www.google.com/favicon.ico" },
			"want": { "kind": "download", "url": "https://www.google.com/favicon.ico" }
		},
		{
			"name": "junk URL is rejected",
			"payload": { "url": "not a url at all" },
			"want": null
		},
		{
			"name": "text-only representations are rejected",
			"payload": { "otherTypes": ["text/plain"] },
			"want": null
		},
		{
			"name": "a file location wins over everything else on offer",
			"payload": { "fileLocation": "C:\\a.png", "image": { "hex": "89504e470d0a1a0a", "zeros": 40 }, "url": "https://x.com/a.png" },
			"want": { "kind": "open", "path": "C:\\a.png" }
		},
		{
			"name": "empty image bytes fall through to the URL",
			"payload": { "image": { "hex": "", "zeros": 0 }, "url": "https://x.com/a.png" },
			"want": { "kind": "download", "url": "https://x.com/a.png" }
		},
		{
			"name": "other representations are materialised, text ones never",
			"payload": { "otherTypes": ["text/plain", "model/stl", "text/uri-list", "Files"] },
			"want": { "kind": "materialise", "types": ["model/stl", "Files"] }
		},
		{ "name": "tool-to-tool drag keeps .stl", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.stl" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.stl" } },
		{ "name": "tool-to-tool drag keeps .msh", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.msh" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.msh" } },
		{ "name": "tool-to-tool drag keeps .vtu", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.vtu" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.vtu" } },
		{ "name": "tool-to-tool drag keeps .mp4", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.mp4" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.mp4" } },
		{ "name": "tool-to-tool drag keeps .mkv", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.mkv" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.mkv" } },
		{ "name": "tool-to-tool drag keeps .flac", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.flac" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.flac" } },
		{ "name": "tool-to-tool drag keeps .zip", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.zip" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.zip" } },
		{ "name": "tool-to-tool drag keeps .docx", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.docx" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.docx" } },
		{ "name": "tool-to-tool drag keeps .pdf", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.pdf" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.pdf" } },
		{ "name": "tool-to-tool drag keeps .png", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.png" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.png" } },
		{ "name": "tool-to-tool drag keeps .obj", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.obj" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.obj" } },
		{ "name": "tool-to-tool drag keeps .heic", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.heic" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.heic" } },
		{ "name": "tool-to-tool drag keeps .svg", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.svg" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.svg" } },
		{ "name": "tool-to-tool drag keeps .bin", "payload": { "fileLocation": "C:\\Temp\\zing-drag-test\\drag-test.bin" }, "want": { "kind": "open", "path": "C:\\Temp\\zing-drag-test\\drag-test.bin" } }
	],
	"droppedNames": [
		{ "name": "unnamed bytes get a timestamped name and a sniffed extension", "bytes": { "hex": "89504e470d0a1a0a", "zeros": 40 }, "suggestedName": null, "want": "dropped-1753800000.png" },
		{ "name": "unrecognised bytes fall back to png", "bytes": { "hex": "", "zeros": 8 }, "suggestedName": "x", "want": "x.png" },
		{ "name": "a name with an extension is kept", "bytes": { "hex": "89504e470d0a1a0a", "zeros": 40 }, "suggestedName": "photo.jpeg", "want": "photo.jpeg" }
	],
	"downloadNames": [
		{ "name": "the response type names the extension", "url": "https://www.google.com/favicon.ico", "mime": "image/x-icon", "bytes": { "hex": "", "zeros": 200 }, "want": "favicon.ico" },
		{ "name": "a bare host is download, typed from the response", "url": "https://x.com/", "mime": "image/jpeg", "bytes": { "hex": "", "zeros": 0 }, "want": "download.jpeg" },
		{ "name": "the query never reaches the name", "url": "https://x.com/img?id=7", "mime": null, "bytes": { "hex": "89504e470d0a1a0a", "zeros": 40 }, "want": "img.png" },
		{ "name": "unknown everything is .bin", "url": "https://x.com/blob", "mime": "application/octet-stream", "bytes": { "hex": "", "zeros": 4 }, "want": "blob.bin" },
		{ "name": "percent-escapes are decoded", "url": "https://x.com/my%20cat.png", "mime": null, "bytes": { "hex": "89504e470d0a1a0a", "zeros": 40 }, "want": "my cat.png" },
		{ "name": "malformed escapes are kept literally", "url": "https://x.com/100%25.png", "mime": null, "bytes": { "hex": "89504e470d0a1a0a", "zeros": 40 }, "want": "100%.png" },
		{ "name": "characters Windows refuses don't reach the disk", "url": "https://x.com/a:b%3F.png", "mime": null, "bytes": { "hex": "89504e470d0a1a0a", "zeros": 40 }, "want": "a-b-.png" },
		{ "name": "the mime type is matched without case", "url": "https://x.com/doc", "mime": "Application/PDF", "bytes": { "hex": "", "zeros": 4 }, "want": "doc.pdf" }
	],
	"sniff": [
		{ "name": "png", "bytes": { "hex": "89504e47", "zeros": 12 }, "want": "png" },
		{ "name": "jpg", "bytes": { "hex": "ffd8ffe0", "zeros": 12 }, "want": "jpg" },
		{ "name": "gif", "bytes": { "hex": "47494638", "zeros": 12 }, "want": "gif" },
		{ "name": "pdf", "bytes": { "hex": "25504446", "zeros": 12 }, "want": "pdf" },
		{ "name": "a truncated webp header is null", "bytes": { "hex": "5249464600000000574542", "zeros": 0 }, "want": null },
		{ "name": "webp", "bytes": { "hex": "52494646000000005745425000000000", "zeros": 0 }, "want": "webp" },
		{ "name": "mp4", "bytes": { "hex": "0000001866747970", "zeros": 12 }, "want": "mp4" },
		{ "name": "too short is null", "bytes": { "hex": "89504e", "zeros": 0 }, "want": null },
		{ "name": "unknown is null", "bytes": { "hex": "", "zeros": 16 }, "want": null }
	],
	"uniqueNames": [
		{ "name": "counts up from 2, before the extension", "file": "a.png", "taken": ["a.png", "a 2.png"], "want": "a 3.png" },
		{ "name": "no extension", "file": "README", "taken": ["README"], "want": "README 2" },
		{ "name": "free name is kept", "file": "free.txt", "taken": [], "want": "free.txt" }
	],
	"extensions": [
		{ "name": "a leading dot is not an extension", "file": ".hidden", "want": "" },
		{ "name": "the last dot counts", "file": "archive.tar.gz", "want": "gz" },
		{ "name": "a trailing dot is none", "file": "name.", "want": "" },
		{ "name": "no dot", "file": "README", "want": "" }
	],
	"filePaths": [
		{ "name": "file URL with escapes", "location": "file:///C:/Users/me/My%20Pictures/a.png", "want": "C:\\Users\\me\\My Pictures\\a.png" },
		{ "name": "file URL with a host is a UNC path", "location": "file://server/share/a.png", "want": "\\\\server\\share\\a.png" },
		{ "name": "a drive path is used as given", "location": "D:\\x.stl", "want": "D:\\x.stl" },
		{ "name": "a UNC path is used as given", "location": "\\\\server\\share\\x.stl", "want": "\\\\server\\share\\x.stl" },
		{ "name": "a web URL is not a file", "location": "https://x.com/a.png", "want": null },
		{ "name": "a bare name is not a file", "location": "a.png", "want": null }
	],
	"webUrls": [
		{ "name": "whitespace is tolerated and spaces escaped", "item": "  https://x.com/a b.png \n", "want": "https://x.com/a%20b.png" },
		{ "name": "javascript is refused", "item": "javascript:alert(1)", "want": null },
		{ "name": "file is refused", "item": "file:///C:/a.png", "want": null },
		{ "name": "ftp is refused", "item": "ftp://x.com/a", "want": null }
	],
	"safeNames": [
		{ "name": "trailing dots and spaces go", "file": "name. . ", "want": "name" },
		{ "name": "reserved characters become dashes", "file": "a<b>c:d\"e/f\\g|h?i*j", "want": "a-b-c-d-e-f-g-h-i-j" }
	],
	"targets": [
		{ "name": "Files takes dropped files", "content": "section:Files", "want": true },
		{ "name": "Convert takes dropped files", "content": "section:Convert", "want": true },
		{ "name": "the background remover takes dropped files", "content": "tool:Background Remover", "want": true },
		{ "name": "Download does not", "content": "section:Download", "want": false },
		{ "name": "Hashes does not", "content": "tool:Hashes", "want": false }
	],
	"dragTypes": [
		{ "name": "plain text is accepted but not noticed", "types": ["text/plain"], "accepts": true, "notices": false },
		{ "name": "Files are accepted and noticed", "types": ["Files"], "accepts": true, "notices": true },
		{ "name": "html is neither", "types": ["text/html"], "accepts": false, "notices": false },
		{ "name": "a URL list is both", "types": ["text/html", "text/uri-list"], "accepts": true, "notices": true }
	]
}
