{
	"_doc": "Shared by pageProbe.test.ts and TabLifecycleTests.cs. 1e999 stands for Infinity, which JSON cannot spell.",
	"accepted": [
		{ "name": "accepts the probe shape", "input": { "scrollY": 120, "dirty": false, "capturing": false, "pictureInPicture": false, "uploading": false }, "expect": { "scrollY": 120, "dirty": false, "capturing": false, "pictureInPicture": false, "uploading": false } },
		{ "name": "clamps negative overscroll to the top", "input": { "scrollY": -5, "dirty": true, "capturing": false, "pictureInPicture": false, "uploading": false }, "expect": { "scrollY": 0, "dirty": true, "capturing": false, "pictureInPicture": false, "uploading": false } },
		{ "name": "reads each keep-awake flag", "input": { "scrollY": 0, "dirty": false, "capturing": true, "pictureInPicture": true, "uploading": true }, "expect": { "scrollY": 0, "dirty": false, "capturing": true, "pictureInPicture": true, "uploading": true } },
		{ "name": "ignores extra fields", "input": { "scrollY": 3.5, "dirty": true, "capturing": false, "pictureInPicture": false, "uploading": false, "x": 1 }, "expect": { "scrollY": 3.5, "dirty": true, "capturing": false, "pictureInPicture": false, "uploading": false } }
	],
	"rejected": [
		null, "x", [], {},
		{ "scrollY": "a", "dirty": false, "capturing": false, "pictureInPicture": false, "uploading": false },
		{ "scrollY": 1e999, "dirty": false, "capturing": false, "pictureInPicture": false, "uploading": false },
		{ "scrollY": 1, "dirty": "no", "capturing": false, "pictureInPicture": false, "uploading": false },
		{ "scrollY": 1, "dirty": false, "capturing": 1, "pictureInPicture": false, "uploading": false },
		{ "scrollY": 1, "dirty": false, "capturing": false, "uploading": false },
		{ "scrollY": 1, "dirty": false },
		{ "scrollY": 1 },
		{ "dirty": false }
	]
}
