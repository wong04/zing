{
	"_doc": "Shared by pageProbe.test.ts and TabLifecycleTests.cs. 1e999 stands for Infinity, which JSON cannot spell.",
	"accepted": [
		{ "name": "accepts the probe shape", "input": { "scrollY": 120, "dirty": false, "liveStream": false, "pictureInPicture": false }, "expect": { "scrollY": 120, "dirty": false, "liveStream": false, "pictureInPicture": false } },
		{ "name": "clamps negative overscroll to the top", "input": { "scrollY": -5, "dirty": true, "liveStream": false, "pictureInPicture": false }, "expect": { "scrollY": 0, "dirty": true, "liveStream": false, "pictureInPicture": false } },
		{ "name": "reads a live stream and picture-in-picture", "input": { "scrollY": 0, "dirty": false, "liveStream": true, "pictureInPicture": true }, "expect": { "scrollY": 0, "dirty": false, "liveStream": true, "pictureInPicture": true } },
		{ "name": "ignores extra fields", "input": { "scrollY": 3.5, "dirty": true, "liveStream": false, "pictureInPicture": false, "x": 1 }, "expect": { "scrollY": 3.5, "dirty": true, "liveStream": false, "pictureInPicture": false } }
	],
	"rejected": [
		null, "x", [], {},
		{ "scrollY": "a", "dirty": false, "liveStream": false, "pictureInPicture": false },
		{ "scrollY": 1e999, "dirty": false, "liveStream": false, "pictureInPicture": false },
		{ "scrollY": 1, "dirty": "no", "liveStream": false, "pictureInPicture": false },
		{ "scrollY": 1, "dirty": false, "liveStream": false, "pictureInPicture": 1 },
		{ "scrollY": 1, "dirty": false, "liveStream": "yes", "pictureInPicture": false },
		{ "scrollY": 1, "dirty": false, "pictureInPicture": false },
		{ "scrollY": 1, "dirty": false },
		{ "scrollY": 1 },
		{ "dirty": false }
	]
}
