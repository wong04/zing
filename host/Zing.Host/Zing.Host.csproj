<Project Sdk="Microsoft.NET.Sdk">
	<!-- The Zing app: a plain Win32 window hosting WebView2s, with WinUI's windowing API for the title bar. Logic lives in Zing.Core. -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<AssemblyName>Zing</AssemblyName>
		<TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
		<!-- KeyCredentialManager.RequestCreateForWindowAsync and KeyCredential.RequestSignForWindowAsync, the only Hello calls that work unpackaged (check C1), are in the 26100 SDK. -->
		<WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
		<!-- That SDK's CsWinRT flags collection expressions typed as read-only interfaces, which only matters for trimming and AOT; Zing is neither. -->
		<NoWarn>$(NoWarn);CsWinRT1032</NoWarn>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
		<UseWinUI>true</UseWinUI>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<Platforms>x64</Platforms>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<ApplicationIcon>..\..\build\icons\icon.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
	</ItemGroup>
	<ItemGroup>
		<!-- Built from TypeScript by `npm run gen:reader` (part of `npm run build:host`). -->
		<Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
		<!-- The taskbar tiles (C3 logo), from `npm run make-icons`. -->
		<Content Include="..\..\build\icons\icon.ico" Link="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\..\build\icons-dark-tile\icon.ico" Link="Assets\icon-dark-tile.ico" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Zing.Core\Zing.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- Where `npm run build` puts the renderer in this checkout. The app loads it from here and never searches (RendererLocation). -->
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>RendererFolder</_Parameter1>
			<_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\out\renderer'))</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
