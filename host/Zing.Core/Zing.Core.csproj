<Project Sdk="Microsoft.NET.Sdk">
	<!-- Host logic with no UI dependency, so it is unit-tested without a window. -->
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Zing.Core.Tests" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="NSec.Cryptography" Version="26.4.0" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
		<PackageReference Include="zxcvbn-core" Version="7.0.92" />
	</ItemGroup>
	<ItemGroup>
		<!-- Generated from the TypeScript sources by `npm run gen:host-defaults`. -->
		<None Include="Defaults\*.json" CopyToOutputDirectory="PreserveNewest" />
		<!-- From https://publicsuffix.org/list/public_suffix_list.dat (MPL 2.0); refresh by downloading it again. -->
		<None Include="Defaults\public_suffix_list.dat" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
