		"electron": "^45.1.0",
		"electron-vite": "^6.0.0",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@ghostery/adblocker-electron": "2.20.1",
		"@mozilla/readability": "0.6.0",
